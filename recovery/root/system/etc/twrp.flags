# mountpoint   fstype   device   flags

/bootloader   emmc   /dev/block/bootloader   flags=backup=1
/logo         emmc   /dev/block/logo         flags=backup=1
/vbmeta       emmc   /dev/block/vbmeta       flags=backup=1
/recovery     emmc   /dev/block/recovery     flags=backup=1
/boot         emmc   /dev/block/boot         flags=backup=1
/misc         emmc   /dev/block/misc

/system       ext4   /dev/block/system       flags=display="System";backup=1
/vendor       ext4   /dev/block/vendor       flags=display="Vendor";backup=1
/odm          ext4   /dev/block/odm          flags=display="ODM";backup=1
/odm_ext      ext4   /dev/block/odm_ext      flags=display="ODM Ext";backup=1
/oem          ext4   /dev/block/oem          flags=display="OEM";backup=1
/product      ext4   /dev/block/product      flags=display="Product";backup=1
/param        ext4   /dev/block/param        flags=backup=1
/tee          ext4   /dev/block/tee          flags=backup=1
/metadata     ext4   /dev/block/metadata     flags=display="Metadata"
/cache        ext4   /dev/block/cache

/data         ext4   /dev/block/data         flags=encryptable=footer;fileencryption=

/external_sd  auto   /dev/block/mmcblk1p1    /dev/block/mmcblk1   flags=display="SD Card";storage;wipeingui;removable
/usb_otg      auto   /dev/block/sda1         /dev/block/sda       flags=display="USB OTG";storage;wipeingui;removable
